{
  "name": "@mozaik-ai/cloud-sdk",
  "version": "0.1.5",
  "bin": {
    "mozaik-cloud": "src/bin.mjs"
  },
  "description": "Send events to mozaik cloud — a runtime-free client, a browser-safe ./lite, and a Mozaik runtime exporter at ./exporter.",
  "license": "MIT",
  "files": [
    "dist",
    "src/bin.mjs"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./exporter": {
      "types": "./dist/exporter.d.ts",
      "default": "./dist/exporter.mjs"
    },
    "./loops": {
      "types": "./dist/loops.d.ts",
      "default": "./dist/loops.mjs"
    },
    "./loop-repository": {
      "types": "./dist/loop-repository.d.ts",
      "default": "./dist/loop-repository.mjs"
    },
    "./lite": {
      "types": "./dist/lite.d.ts",
      "default": "./dist/lite.mjs"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "@mozaik-ai/core": "^4.0.0-beta.1 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@mozaik-ai/core": {
      "optional": true
    }
  }
}
